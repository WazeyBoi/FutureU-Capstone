{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-13-215-46-99.ap-southeast-1.compute.amazonaws.com:8080/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}