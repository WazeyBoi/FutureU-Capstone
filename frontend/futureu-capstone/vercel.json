{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-18-143-161-32.ap-southeast-1.compute.amazonaws.com:8080/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
